# Gradle
.gradle/
/build/
/app/build/
build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Local configuration file (SDK path, etc.)
local.properties

# Kotlin
.kotlin/

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Log/OS files
*.log
.DS_Store
Thumbs.db

# Release signing — never commit the key or its passwords
keystore.properties
*.jks
*.keystore

# Project scratch / debug artifacts
.shots/
.tmp_verify/
.debug/

# ...except the shared *debug* key, which is deliberately not a secret: it is
# what lets every CI build install over the last one. Base64 so the exception
# is to a named file rather than to the pattern above.
!app/debug.keystore.b64
